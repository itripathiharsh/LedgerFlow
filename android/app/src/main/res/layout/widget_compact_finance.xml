<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_flow_dark"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top brand + currency -->
    <LinearLayout
        android:id="@+id/mini_header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/mini_brand_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:text="LEDGERFLOW"
            android:textColor="#10B981"
            android:textSize="9sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/mini_lock_icon"
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="Balances hidden"
            android:src="@drawable/ic_widget_lock"
            android:visibility="gone" />

        <TextView
            android:id="@+id/mini_currency_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip_flow_dark"
            android:includeFontPadding="false"
            android:paddingLeft="6dp"
            android:paddingTop="2dp"
            android:paddingRight="6dp"
            android:paddingBottom="2dp"
            android:text="INR"
            android:textColor="#A7C4B5"
            android:textSize="8sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Stacked Compact Wells -->
    <LinearLayout
        android:id="@+id/mini_metrics_col"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="7dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/mini_spend_well"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="5dp"
            android:layout_weight="1"
            android:background="@drawable/widget_well_flow_dark"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingLeft="9dp"
            android:paddingRight="9dp">

            <TextView
                android:id="@+id/mini_today_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:letterSpacing="0.05"
                android:maxLines="1"
                android:text="TODAY'S SPEND"
                android:textColor="#7DA894"
                android:textSize="8sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mini_today_spend_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="₹0.00"
                android:textColor="#EBF6F0"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/mini_balance_well"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/widget_well_flow_dark"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingLeft="9dp"
            android:paddingRight="9dp">

            <TextView
                android:id="@+id/mini_balance_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:letterSpacing="0.05"
                android:maxLines="1"
                android:text="BALANCE"
                android:textColor="#7DA894"
                android:textSize="8sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mini_liquid_balance_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="₹0.00"
                android:textColor="#10B981"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_mini_add_expense"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="@drawable/widget_pill_emerald"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="+ Expense"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/btn_mini_voice"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_circle_btn_flow_dark"
            android:clickable="true"
            android:contentDescription="Voice Expense"
            android:focusable="true">

            <ImageView
                android:id="@+id/icon_mini_voice"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:contentDescription="Voice Expense"
                android:src="@drawable/ic_widget_mic" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
