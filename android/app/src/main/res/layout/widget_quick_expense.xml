<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_flow_dark"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="12dp"
    android:paddingTop="8dp"
    android:paddingRight="12dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/quick_brand_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/quick_brand_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:letterSpacing="0.08"
            android:text="LEDGERFLOW"
            android:textColor="#10B981"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/quick_today_spend_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:text="₹0 today"
            android:textColor="#A7C4B5"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/btn_quick_add_expense"
        android:layout_width="0dp"
        android:layout_height="38dp"
        android:layout_weight="1"
        android:background="@drawable/widget_pill_emerald"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:text="+ Expense"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <FrameLayout
        android:id="@+id/btn_quick_voice_expense"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/widget_circle_btn_flow_dark"
        android:clickable="true"
        android:contentDescription="Voice Expense"
        android:focusable="true">

        <ImageView
            android:id="@+id/icon_quick_voice"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:layout_gravity="center"
            android:contentDescription="Voice Expense"
            android:src="@drawable/ic_widget_mic" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/btn_quick_add_income"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/widget_circle_btn_flow_dark"
        android:clickable="true"
        android:contentDescription="Quick Income"
        android:focusable="true">

        <ImageView
            android:id="@+id/icon_quick_income"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:layout_gravity="center"
            android:contentDescription="Quick Income"
            android:src="@drawable/ic_widget_income" />
    </FrameLayout>
</LinearLayout>
